generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────

enum Role {
  applicant
  officer
}

enum Sector {
  manufacturing
  chemical
  food_processing
  textiles
  pharma
  other
}

enum Scale {
  micro
  small
  medium
  large
}

enum RiskCategory {
  green
  white
  orange
  red
}

enum Stage {
  new_unit
  expansion
  operational
}

enum ApplicationStatus {
  not_started
  submitted
  in_review
  info_requested
  approved
  rejected
}

// ─── Models ──────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  name              String?
  email             String?  @unique
  phone             String?  @unique
  role              Role     @default(applicant)
  officerDepartment String?  @map("officer_department")
  createdAt         DateTime @default(now()) @map("created_at")

  profile          ApplicantProfile?
  applications     Application[]
  personalInfo     PersonalInfo?
  businessInfo     BusinessInfo?
  documents        Document[]
  documentComments DocumentComment[]
  inspectionsAssigned InspectionOfficer[]
  grievancesFiled     Grievance[]

  @@map("users")
}

model ApplicantProfile {
  id                     String       @id @default(cuid())
  userId                 String       @unique @map("user_id")
  sector                 Sector
  scale                  Scale
  locationDistrict       String       @map("location_district")
  inNotifiedIndustrialZone Boolean    @map("in_notified_industrial_zone")
  riskCategory           RiskCategory @map("risk_category")
  stage                  Stage
  createdAt              DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("applicant_profiles")
}

model ApprovalType {
  id          String  @id @default(cuid())
  name        String
  department  String
  description String
  dependsOnId String? @map("depends_on_id")

  dependsOn   ApprovalType?  @relation("ApprovalDependency", fields: [dependsOnId], references: [id])
  dependedBy  ApprovalType[] @relation("ApprovalDependency")
  rules       ApprovalRule[]
  applications Application[]
  documentRequirements ApprovalTypeDocumentRequirement[]

  @@map("approval_types")
}

model ApprovalRule {
  id                   String        @id @default(cuid())
  approvalTypeId       String        @map("approval_type_id")
  appliesToSector      Sector?       @map("applies_to_sector")
  appliesToScale       Scale?        @map("applies_to_scale")
  appliesToRiskCategory RiskCategory? @map("applies_to_risk_category")
  appliesToZone        Boolean?      @map("applies_to_zone")
  isSelfCertifiable    Boolean       @default(false) @map("is_self_certifiable")

  approvalType ApprovalType @relation(fields: [approvalTypeId], references: [id])

  @@map("approval_rules")
}

model Application {
  id                String            @id @default(cuid())
  applicantId       String            @map("applicant_id")
  approvalTypeId    String            @map("approval_type_id")
  status            ApplicationStatus @default(not_started)
  riskCategory      RiskCategory      @map("risk_category")
  assignedOfficerDept String?         @map("assigned_officer_dept")
  slaDays           Int               @default(30) @map("sla_days")
  slaDueDate        DateTime?         @map("sla_due_date")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  applicant            User                  @relation(fields: [applicantId], references: [id])
  approvalType         ApprovalType          @relation(fields: [approvalTypeId], references: [id])
  applicationDocuments ApplicationDocument[]
  inspections          Inspection[]
  grievances           Grievance[]

  @@map("applications")
}

model Scheme {
  id                String  @id @default(cuid())
  name              String
  description       String
  eligibilitySector Sector? @map("eligibility_sector")
  eligibilityScale  Scale?  @map("eligibility_scale")
  eligibilityDistrict String? @map("eligibility_district")
  subsidyDetail     String  @map("subsidy_detail")
  sourceUrl         String  @map("source_url")

  @@map("schemes")
}

// ─── New Enums (Upgrade) ─────────────────────────

enum BusinessType {
  proprietorship
  partnership
  pvt_ltd
  llp
  other
}

enum DocumentType {
  aadhar
  pan
  gstin_certificate
  factory_layout_plan
  land_ownership_proof
  electricity_bill
  building_plan_copy
  fire_safety_layout
  pollution_control_cert
  water_usage_plan
  labour_license_copy
  noc_previous
  incorporation_cert
  udyam_certificate
  other
}

enum DocStatus {
  missing
  attached
  verified
  rejected
}

// ─── New Models (Upgrade) ─────────────────────────

model PersonalInfo {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  fullName       String   @map("full_name")
  dob            String?  // stored as ISO date string
  aadharEncrypted String? @map("aadhar_encrypted") // AES-256-GCM encrypted — see lib/crypto.ts
  panEncrypted    String? @map("pan_encrypted")     // AES-256-GCM encrypted — see lib/crypto.ts
  address        String?
  contactEmail   String?  @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  alternateContact String? @map("alternate_contact")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("personal_info")
}

model BusinessInfo {
  id                     String       @id @default(cuid())
  userId                 String       @unique @map("user_id")
  businessName           String       @map("business_name")
  businessType           BusinessType @map("business_type")
  gstin                  String?
  udyamRegistrationNumber String?     @map("udyam_registration_number")
  incorporationDate      String?      @map("incorporation_date") // ISO date string
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("business_info")
}

model Document {
  id           String       @id @default(cuid())
  userId       String       @map("user_id")
  documentType DocumentType @map("document_type")
  fileUrl      String       @map("file_url")
  fileName     String       @map("file_name")
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")
  expiryDate   DateTime?    @map("expiry_date")

  user                 User                  @relation(fields: [userId], references: [id])
  applicationDocuments ApplicationDocument[]

  @@map("documents")
}

model ApprovalTypeDocumentRequirement {
  id             String       @id @default(cuid())
  approvalTypeId String       @map("approval_type_id")
  documentType   DocumentType @map("document_type")
  isMandatory    Boolean      @default(true) @map("is_mandatory")

  approvalType ApprovalType @relation(fields: [approvalTypeId], references: [id])

  @@map("approval_type_document_requirements")
}

model ApplicationDocument {
  id            String       @id @default(cuid())
  applicationId String       @map("application_id")
  documentId    String?      @map("document_id") // null = required but not yet uploaded
  documentType  DocumentType @map("document_type")
  status        DocStatus    @default(missing)

  application Application      @relation(fields: [applicationId], references: [id])
  document    Document?         @relation(fields: [documentId], references: [id])
  comments    DocumentComment[]

  @@map("application_documents")
}

model DocumentComment {
  id                    String   @id @default(cuid())
  applicationDocumentId String   @map("application_document_id")
  officerId             String   @map("officer_id")
  commentText           String   @map("comment_text")
  createdAt             DateTime @default(now()) @map("created_at")

  applicationDocument ApplicationDocument @relation(fields: [applicationDocumentId], references: [id])
  officer             User                @relation(fields: [officerId], references: [id])

  @@map("document_comments")
}

// ─── Core Extensions: CIS, SLAs & Grievance ───────

enum InspectionStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum GrievanceTier {
  tier_1_district
  tier_2_state
}

enum GrievanceStatus {
  pending
  under_review
  resolved
  rejected
}

model Inspection {
  id            String           @id @default(cuid())
  applicationId String           @map("application_id")
  scheduledDate DateTime         @map("scheduled_date")
  status        InspectionStatus @default(scheduled)
  findings      String?
  reportUrl     String?          @map("report_url")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  application   Application         @relation(fields: [applicationId], references: [id])
  officers      InspectionOfficer[]

  @@map("inspections")
}

model InspectionOfficer {
  id           String @id @default(cuid())
  inspectionId String @map("inspection_id")
  officerId    String @map("officer_id")
  department   String

  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  officer      User       @relation(fields: [officerId], references: [id])

  @@map("inspection_officers")
}

model Grievance {
  id                String          @id @default(cuid())
  applicationId     String          @map("application_id")
  applicantId       String          @map("applicant_id")
  tier              GrievanceTier   @default(tier_1_district)
  subject           String
  description       String
  status            GrievanceStatus @default(pending)
  resolutionRemarks String?         @map("resolution_remarks")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  application       Application @relation(fields: [applicationId], references: [id])
  applicant         User        @relation(fields: [applicantId], references: [id])

  @@map("grievances")
}
